---
/**
 * A real 3D terrain of Pazhayannur Grama Panchayat, built from actual
 * elevation data (src/data/terrain.json — see scripts/process-terrain.py).
 * Not decorative: every vertex height is a real measured elevation, and
 * the glowing outline is the true surveyed panchayat boundary, draped
 * onto the terrain surface at its real position.
 *
 * Colour: vaka -> vakadeep (elevation gradient, inside the boundary),
 * dimmed toward ink2 outside it, turmeric for the boundary line — all
 * existing Panchavarnam tokens, nothing new introduced.
 */
---

<div class="reveal" style="--d:160ms">
  <div
    id="terrain-map"
    class="relative rounded-2xl overflow-hidden border border-rice/12 bg-ink2"
    style="aspect-ratio: 16 / 10;"
  >
    <div
      id="terrain-loading"
      class="absolute inset-0 flex items-center justify-center font-mono text-[10px] tracking-[0.22em] uppercase text-rice/35"
    >
      Loading terrain&hellip;
    </div>
    <canvas id="terrain-canvas" class="absolute inset-0 w-full h-full"></canvas>

    <div
      class="pointer-events-none absolute bottom-4 left-4 right-4 flex flex-wrap items-end justify-between gap-3"
    >
      <p class="font-mono text-[10px] tracking-[0.18em] uppercase text-rice/45 bg-ink/60 backdrop-blur-sm rounded-full px-3 py-1.5">
        Drag to rotate &middot; scroll to zoom
      </p>
      <p
        id="terrain-elevation-label"
        class="font-mono text-[10px] tracking-[0.18em] uppercase text-rice/45 bg-ink/60 backdrop-blur-sm rounded-full px-3 py-1.5"
      ></p>
    </div>
  </div>
  <p class="font-mono text-[10px] tracking-[0.22em] uppercase text-rice/35 mt-3">
    Real elevation data, sampled against the surveyed panchayat boundary
    <span lang="ml" class="font-mal normal-case tracking-normal text-rice/30"> · യഥാർത്ഥ ഭൂപ്രകൃതി</span>
  </p>
</div>

<script>
  import * as THREE from "three";
  import { OrbitControls } from "three/examples/jsm/controls/OrbitControls.js";
  import terrain from "../data/terrain.json";

  const VERTICAL_EXAGGERATION = 2.2;
  const BOUNDARY_LIFT = 4; // metres above the surface, avoids z-fighting

  function initTerrain() {
    const container = document.getElementById("terrain-map") as HTMLElement | null;
    const canvas = document.getElementById("terrain-canvas") as HTMLCanvasElement | null;
    const loading = document.getElementById("terrain-loading");
    const elevationLabel = document.getElementById("terrain-elevation-label");
    if (!container || !canvas) return;

    let renderer: THREE.WebGLRenderer;
    try {
      renderer = new THREE.WebGLRenderer({ canvas, antialias: true, alpha: true });
    } catch {
      if (loading) loading.textContent = "3D terrain unavailable on this device.";
      return;
    }

    const { gridCols: cols, gridRows: rows, widthMetres, heightMetres, elevations, insideMask, elevationMin, elevationMax, boundary } =
      terrain as {
        gridCols: number;
        gridRows: number;
        widthMetres: number;
        heightMetres: number;
        elevations: number[];
        insideMask: boolean[];
        elevationMin: number;
        elevationMax: number;
        boundary: { outer: [number, number][]; holes: [number, number][][] };
      };

    if (elevationLabel) {
      // The label reports the true panchayat range (matching the rest of
      // the site), not the padded sampling area's wider range, which
      // includes terrain outside the actual boundary.
      const insideElevations = elevations.filter((_, i) => insideMask[i]);
      const insideMin = Math.min(...insideElevations);
      const insideMax = Math.max(...insideElevations);
      elevationLabel.textContent = `${Math.round(insideMin)}–${Math.round(insideMax)} m`;
    }

    const heightAt = (col: number, row: number) => elevations[row * cols + col];
    const toY = (elevation: number) => (elevation - elevationMin) * VERTICAL_EXAGGERATION;

    // --- geometry: explicit vertex grid, so row/col ordering is unambiguous ---
    const positions = new Float32Array(cols * rows * 3);
    const colors = new Float32Array(cols * rows * 3);

    const vakaLight = new THREE.Color(0x3f9670);
    const vakaDeep = new THREE.Color(0x14452f);
    const dimTone = new THREE.Color(0x191512); // ink2

    for (let row = 0; row < rows; row++) {
      for (let col = 0; col < cols; col++) {
        const idx = row * cols + col;
        const x = (col / (cols - 1)) * widthMetres - widthMetres / 2;
        const z = (row / (rows - 1)) * heightMetres - heightMetres / 2;
        const elevation = elevations[idx];
        const y = toY(elevation);

        positions[idx * 3] = x;
        positions[idx * 3 + 1] = y;
        positions[idx * 3 + 2] = z;

        const t = (elevation - elevationMin) / Math.max(1, elevationMax - elevationMin);
        const base = vakaLight.clone().lerp(vakaDeep, t);
        const shaded = insideMask[idx] ? base : base.lerp(dimTone, 0.68);
        colors[idx * 3] = shaded.r;
        colors[idx * 3 + 1] = shaded.g;
        colors[idx * 3 + 2] = shaded.b;
      }
    }

    const indices: number[] = [];
    for (let row = 0; row < rows - 1; row++) {
      for (let col = 0; col < cols - 1; col++) {
        const a = row * cols + col;
        const b = row * cols + col + 1;
        const c = (row + 1) * cols + col;
        const d = (row + 1) * cols + col + 1;
        indices.push(a, c, b, b, c, d);
      }
    }

    const geometry = new THREE.BufferGeometry();
    geometry.setAttribute("position", new THREE.BufferAttribute(positions, 3));
    geometry.setAttribute("color", new THREE.BufferAttribute(colors, 3));
    geometry.setIndex(indices);
    geometry.computeVertexNormals();

    const material = new THREE.MeshStandardMaterial({
      vertexColors: true,
      roughness: 0.9,
      metalness: 0,
      flatShading: false,
    });
    const terrainMesh = new THREE.Mesh(geometry, material);

    // --- boundary outline, draped on the real terrain surface ---
    const nearestElevation = (worldX: number, worldZ: number) => {
      const col = Math.round(((worldX + widthMetres / 2) / widthMetres) * (cols - 1));
      const row = Math.round(((worldZ + heightMetres / 2) / heightMetres) * (rows - 1));
      const c = Math.min(cols - 1, Math.max(0, col));
      const r = Math.min(rows - 1, Math.max(0, row));
      return heightAt(c, r);
    };

    const boundaryPoints = boundary.outer.map(([bx, bz]) => {
      const x = bx - widthMetres / 2;
      const z = bz - heightMetres / 2;
      const y = toY(nearestElevation(x, z)) + BOUNDARY_LIFT;
      return new THREE.Vector3(x, y, z);
    });
    boundaryPoints.push(boundaryPoints[0]);

    const curve = new THREE.CatmullRomCurve3(boundaryPoints, true, "catmullrom", 0.05);
    const tubeRadius = Math.max(6, widthMetres / 900);
    const tubeGeometry = new THREE.TubeGeometry(curve, boundaryPoints.length * 2, tubeRadius, 6, true);
    const tubeMaterial = new THREE.MeshStandardMaterial({
      color: 0xe8a317, // turmeric
      emissive: 0xe8a317,
      emissiveIntensity: 0.55,
      roughness: 0.4,
    });
    const boundaryMesh = new THREE.Mesh(tubeGeometry, tubeMaterial);

    // --- scene ---
    const scene = new THREE.Scene();
    scene.add(terrainMesh, boundaryMesh);
    scene.add(new THREE.AmbientLight(0xf4f0e4, 0.65));
    const sun = new THREE.DirectionalLight(0xf4f0e4, 1.1);
    sun.position.set(widthMetres * 0.3, widthMetres * 0.5, heightMetres * 0.2);
    scene.add(sun);

    const camera = new THREE.PerspectiveCamera(42, 1, 10, widthMetres * 6);
    const maxSpan = Math.max(widthMetres, heightMetres);
    camera.position.set(0, maxSpan * 0.62, maxSpan * 0.78);
    camera.lookAt(0, 0, 0);

    const controls = new OrbitControls(camera, canvas);
    controls.enableDamping = true;
    controls.dampingFactor = 0.08;
    controls.minDistance = maxSpan * 0.35;
    controls.maxDistance = maxSpan * 1.6;
    controls.maxPolarAngle = Math.PI * 0.47;
    controls.target.set(0, 0, 0);
    controls.update();

    function resize() {
      const w = container!.clientWidth;
      const h = container!.clientHeight;
      renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
      renderer.setSize(w, h, false);
      camera.aspect = w / h;
      camera.updateProjectionMatrix();
    }
    resize();
    window.addEventListener("resize", resize);

    let running = true;
    function tick() {
      if (!running) return;
      controls.update();
      renderer.render(scene, camera);
      requestAnimationFrame(tick);
    }
    tick();

    if (loading) loading.remove();

    // pause rendering when off-screen to save battery/GPU
    const visibilityObserver = new IntersectionObserver(
      (entries) => {
        running = entries[0].isIntersecting;
        if (running) tick();
      },
      { threshold: 0.05 },
    );
    visibilityObserver.observe(container);
  }

  // lazy-init once the map scrolls near the viewport
  const trigger = document.getElementById("terrain-map");
  if (trigger) {
    const initObserver = new IntersectionObserver(
      (entries) => {
        if (entries[0].isIntersecting) {
          initTerrain();
          initObserver.disconnect();
        }
      },
      { rootMargin: "200px" },
    );
    initObserver.observe(trigger);
  }
</script>
