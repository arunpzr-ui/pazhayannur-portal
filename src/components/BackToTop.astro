---
/**
 * Site-wide back-to-top button. Alpine controls visibility (appears
 * after scrolling 400px) and the scroll-to-top itself, checking
 * prefers-reduced-motion directly since this bypasses the CSS
 * scroll-behavior rule in global.css.
 */
---

<button
  type="button"
  x-data="{ show: false }"
  x-show="show"
  x-cloak
  x-transition
  @scroll.window="show = window.scrollY > 400"
  @click="window.scrollTo({ top: 0, behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth' })"
  aria-label="Back to top"
  class="fixed bottom-6 right-6 z-40 w-12 h-12 rounded-full glass glass-hover flex items-center justify-center outline-hidden focus-visible:outline-2 focus-visible:outline-turmeric focus-visible:outline-offset-2"
>
  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="text-rice/80" aria-hidden="true">
    <path d="M12 19V5" />
    <path d="M5 12l7-7 7 7" />
  </svg>
</button>
