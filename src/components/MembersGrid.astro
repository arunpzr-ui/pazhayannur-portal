---
import { Image } from "astro:assets";
import members from "../data/members.json";

const images = import.meta.glob<{ default: ImageMetadata }>(
  "../assets/administration/members/*.jpg",
  { eager: true }
);

const getImage = (path: string) => {
  const mod = images[path];
  if (!mod) throw new Error(`Missing member photo: ${path}`);
  return mod.default;
};
---

<div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-3">
  {members.map((m, i) => (
    <div
      class="reveal member-card relative aspect-[3/4] rounded-2xl overflow-hidden border border-rice/12 cursor-pointer"
      style={`--d:${i * 30}ms`}
      x-data="{ open: false }"
      x-on:click="open = !open"
      x-on:keydown.enter="open = !open"
      x-on:keydown.escape="open = false"
      tabindex="0"
      role="button"
      x-bind:aria-expanded="open"
    >
      <Image
        src={getImage(m.image)}
        alt={m.name}
        width={360}
        height={480}
        class="w-full h-full object-cover"
      />

      <div class="member-caption absolute inset-x-0 bottom-0 px-2.5 py-2 bg-gradient-to-t from-ink via-ink/70 to-transparent">
        <p class="font-mono text-[9px] tracking-[0.18em] uppercase text-turmeric/80">
          Ward {m.ward}
        </p>
        <p class="font-display font-bold text-sm text-rice leading-tight mt-0.5">{m.name}</p>
      </div>

      <div
        class="member-overlay absolute inset-0 bg-ink/93 backdrop-blur-sm p-3 flex flex-col justify-center text-center"
        x-show="open"
        x-transition:enter="transition ease-[cubic-bezier(0.16,1,0.3,1)] duration-300"
        x-transition:enter-start="opacity-0"
        x-transition:enter-end="opacity-100"
        x-transition:leave="transition ease-[cubic-bezier(0.16,1,0.3,1)] duration-200"
        x-transition:leave-start="opacity-100"
        x-transition:leave-end="opacity-0"
        x-cloak
      >
        <p class="font-display font-bold text-rice leading-tight">{m.name}</p>
        <p class="font-mono text-[10px] tracking-[0.16em] uppercase text-turmeric/80 mt-2 leading-snug">
          {m.role}
        </p>
        <p lang="ml" class="font-mal text-xs text-rice/50 mt-1 leading-snug">{m.roleMl}</p>
        <p class="font-mono text-[10px] tracking-[0.16em] uppercase text-rice/45 mt-3">
          Ward {m.ward} &middot; {m.wardMl}
        </p>
        <span class="font-mono text-[9px] tracking-[0.16em] uppercase text-rice/35 mt-3 border border-rice/20 rounded-full px-2 py-0.5 self-center">
          {m.party}
        </span>
      </div>
    </div>
  ))}
</div>

<p class="font-mono text-[10px] tracking-[0.22em] uppercase text-rice/35 mt-4 text-center">
  Source: official panchayat member directory
  <span lang="ml" class="font-mal normal-case tracking-normal text-rice/30">
    {" "}&middot; ഫോട്ടോയിൽ ക്ലിക്ക് ചെയ്ത് വിവരങ്ങൾ കാണുക
  </span>
</p>

<style>
  .member-card {
    transition:
      border-color 0.35s var(--ease-panchavarnam, ease),
      transform 0.35s var(--ease-panchavarnam, ease);
  }

  .member-card:hover,
  .member-card:focus-visible {
    border-color: rgb(232 163 23 / 0.5);
  }

  [x-cloak] {
    display: none !important;
  }
</style>
