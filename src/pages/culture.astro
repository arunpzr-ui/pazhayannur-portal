---
import { Image } from "astro:assets";
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import culture from "../data/culture.json";
import townCentre from "../assets/culture/town-centre.jpg";
---

<Base
  title="Life & culture"
  description="The people, festivals and Dravidian–Malayalam inheritance of Pazhayannur, and the five powders of kalamezhuthu behind this site's design."
>
  <Fragment slot="nav">
    <Nav />
  </Fragment>

  <div class="relative overflow-hidden pt-40 pb-20 px-6">
    <div class="mx-auto max-w-6xl">
      <a
        href="/"
        class="font-mono text-[10px] tracking-[0.22em] uppercase text-rice/40 hover:text-rice/70 transition-colors"
      >
        &larr; Pazhayannur
      </a>

      <div class="tagline-rule my-6"></div>

      <div class="reveal flex items-baseline gap-4">
        <span class="font-mono text-xs text-rice/40">04</span>
        <h1 class="font-display font-extrabold text-5xl md:text-7xl leading-[0.92] tracking-[-0.035em]">
          Life &amp; culture
          <span lang="ml" class="block font-mal text-2xl md:text-3xl text-rice/45 mt-3 font-normal">
            സംസ്കാരം
          </span>
        </h1>
      </div>

      <p class="reveal text-rice/60 mt-8 max-w-xl leading-relaxed" style="--d:110ms">
        {culture.intro}
      </p>
      <p lang="ml" class="reveal font-mal text-rice/40 mt-2 max-w-xl leading-relaxed" style="--d:110ms">
        {culture.introMl}
      </p>

      <div class="reveal group mt-12 rounded-2xl overflow-hidden border border-rice/12" style="--d:160ms">
        <Image
          src={townCentre}
          alt="Aerial view of Pazhayannur town centre"
          width={1600}
          height={900}
          class="w-full h-auto object-cover transition-transform duration-500 group-hover:scale-105"
        />
      </div>
      <p class="font-mono text-[10px] tracking-[0.22em] uppercase text-rice/35 mt-3">
        Pazhayannur town centre
        <span lang="ml" class="font-mal normal-case tracking-normal text-rice/30"> · പഴയന്നൂർ അങ്ങാടി</span>
      </p>
    </div>
  </div>

  <section class="border-y border-rice/12 bg-ink2">
    <div class="mx-auto max-w-6xl px-6 py-16 grid grid-cols-2 gap-8 max-w-sm">
      <div class="reveal">
        <p
          class="font-display font-extrabold text-4xl md:text-5xl text-kumkum"
          data-count={culture.people.length}
          data-decimals="0"
          data-suffix=""
        >
          0
        </p>
        <p class="font-mono text-[10px] tracking-[0.22em] uppercase text-rice/45 mt-2">Notable people</p>
        <p lang="ml" class="font-mal text-sm text-rice/40 mt-1">പ്രമുഖർ</p>
      </div>
      <div class="reveal" style="--d:110ms">
        <p
          class="font-display font-extrabold text-4xl md:text-5xl text-kumkum"
          data-count={culture.highlights.length}
          data-decimals="0"
          data-suffix=""
        >
          0
        </p>
        <p class="font-mono text-[10px] tracking-[0.22em] uppercase text-rice/45 mt-2">Landmarks &amp; feasts</p>
        <p lang="ml" class="font-mal text-sm text-rice/40 mt-1">ആഘോഷങ്ങൾ</p>
      </div>
    </div>
  </section>

  <section class="px-6 py-24">
    <div class="mx-auto max-w-6xl">
      <div class="rule mb-6" style="--key: var(--color-kumkum)"></div>
      <div class="reveal flex items-baseline gap-4 mb-10">
        <span class="font-mono text-xs text-rice/40">People</span>
        <h2 class="font-display font-extrabold text-3xl md:text-4xl">
          Sent out into Kerala's arts
          <span lang="ml" class="block font-mal text-base text-rice/45 mt-2">പ്രമുഖർ</span>
        </h2>
      </div>

      <div class="grid sm:grid-cols-2 md:grid-cols-3 gap-4">
        {culture.people.map((p, i) => (
          <div class="reveal glass glass-hover rounded-2xl p-6" style={`--d:${i * 90}ms`}>
            <p class="font-display font-bold text-lg">{p.name}</p>
            <p lang="ml" class="font-mal text-sm text-rice/45 mt-1">{p.ml}</p>
            <p class="font-mono text-[10px] tracking-[0.18em] uppercase text-kumkum/70 mt-4">{p.role}</p>
            <p lang="ml" class="font-mal text-xs text-rice/35 mt-1">{p.roleMl}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="px-6 py-24 bg-ink2 border-y border-rice/12">
    <div class="mx-auto max-w-6xl">
      <div class="rule mb-6" style="--key: var(--color-kumkum)"></div>
      <div class="reveal flex items-baseline gap-4 mb-10">
        <span class="font-mono text-xs text-rice/40">Landmarks &amp; feasts</span>
        <h2 class="font-display font-extrabold text-3xl md:text-4xl">
          What the calendar turns on
          <span lang="ml" class="block font-mal text-base text-rice/45 mt-2">ആഘോഷങ്ങൾ</span>
        </h2>
      </div>

      <div class="grid sm:grid-cols-2 gap-4 max-w-3xl">
        {culture.highlights.map((h, i) => (
          <div class="reveal glass glass-hover rounded-2xl p-6" style={`--d:${i * 90}ms`}>
            <p class="font-mono text-[10px] tracking-[0.18em] uppercase text-kumkum/70 mb-2">{h.tag}</p>
            <p class="font-display font-bold text-lg">{h.title}</p>
            <p lang="ml" class="font-mal text-sm text-rice/40 mt-1">{h.ml}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="px-6 py-24">
    <div class="mx-auto max-w-6xl">
      <div class="rule mb-6" style="--key: var(--color-kumkum)"></div>
      <div class="reveal flex items-baseline gap-4 mb-10">
        <span class="font-mono text-xs text-rice/40">Panchavarnam</span>
        <h2 class="font-display font-extrabold text-3xl md:text-4xl">
          The five powders
          <span lang="ml" class="block font-mal text-base text-rice/45 mt-2">പഞ്ചവർണ്ണം</span>
        </h2>
      </div>

      <p class="reveal text-rice/60 max-w-2xl leading-relaxed mb-10" style="--d:80ms">
        {culture.paletteNote}
      </p>

      <div class="grid sm:grid-cols-2 md:grid-cols-5 gap-4">
        {culture.palette.map((p, i) => (
          <div class="reveal glass glass-hover rounded-2xl p-6" style={`--d:${i * 90}ms`}>
            <div class="w-8 h-8 rounded-full mb-4" style={`background: var(--color-${p.token})`}></div>
            <p class="font-display font-bold">{p.en}</p>
            <p lang="ml" class="font-mal text-sm text-rice/45 mt-1">{p.ml}</p>
            <p class="font-mono text-[10px] tracking-[0.18em] uppercase text-rice/35 mt-3">{p.hex}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <Fragment slot="footer">
    <Footer />
  </Fragment>
</Base>
